# HTTP app port inside the jobscan container
PORT=3050

# PostgreSQL container/app settings
POSTGRES_DB=jobscan
POSTGRES_USER=jobscan
POSTGRES_PASSWORD=replace-with-a-strong-random-password

# oauth2-proxy Google provider settings
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_CALLBACK_URL=https://jobscan.example.com/oauth2/callback

# Generate with: openssl rand -base64 32
COOKIE_SECRET=replace-with-32-byte-random-base64-value

# Optional: override the Gemini model used by CRM processing
# GEMINI_MODEL=gemini-2.5-flash
