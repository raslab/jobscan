{
  "name": "jobscan",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted careers-page aggregator and job-search CRM",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "postbuild": "cp -r src/public dist/public && cp -r src/migrations dist/migrations",
    "start": "node dist/index.js",
    "test": "jest",
    "test:unit": "jest --testPathPatterns='__tests__/parsers'",
    "test:integration": "jest --testPathPatterns='__tests__/integration'"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^4.21.0",
    "node-html-markdown": "^2.0.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
